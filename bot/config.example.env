# ─────────────────────────────────────────────────────
# RED — Routine Every Day  설정 예시
#
# 이 파일을 복사해서 아래 위치에 두고 값을 채우세요.
#   ~/.config/red/config.env
#
# ⚠️ 채운 파일은 절대 git에 올리지 마세요. 토큰이 들어갑니다.
#    저장소 밖(홈 폴더)에 두는 이유가 이것입니다.
# ─────────────────────────────────────────────────────

# BotFather가 준 토큰. 형식은 숫자:영문숫자 조합
TELEGRAM_BOT_TOKEN=여기에_토큰

# 내 대화방 번호. 숫자만. README의 2단계 참고
TELEGRAM_CHAT_ID=여기에_숫자

# ── 아래는 안 적으면 기본값이 쓰인다 ──

# 아침 시간표 링크 (24시간제, KST)
MORNING_TIME=07:00

# 아침 뉴스 링크
NEWS_TIME=07:30

# 밤에 내일 틀 보낼 시각
EVENING_TIME=23:00

# 틀·규칙 원본. 저장소의 template.txt를 그대로 읽어온다
TEMPLATE_URL=https://jaealee.com/schedule/template.txt

# 시간표 뷰어 주소
SCHEDULE_URL=https://jaealee.com/schedule/

# 시간표 JSON 폴더
DATA_URL=https://jaealee.com/schedule/data/

# 뉴스 뷰어 주소
NEWS_URL=https://jaealee.com/news/view.html

# 뉴스 JSON 폴더 (발행 여부 확인용)
NEWS_DATA_URL=https://jaealee.com/news/data/
