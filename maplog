<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no">
<meta name="theme-color" content="#eef3f8">
<title>맵로그</title>
<style>
@font-face{font-family:'Pretendard';font-weight:400;font-style:normal;font-display:swap;src:url(data:font/woff2;base64,) format('woff2')}@font-face{font-family:'Pretendard';font-weight:600;font-style:normal;font-display:swap;src:url(data:font/woff2;base64,) format('woff2')}@font-face{font-family:'Pretendard';font-weight:800;font-style:normal;font-display:swap;src:url(data:font/woff2;base64,) format('woff2')}
:root{
  --paper:#e9eff2; --paper-light:#fbfaf7;
  --ink:#2b2f33; --ink2:#7a8187;
  --bg:#faf7f3; --card:#fff; --text:#1c1b1f; --text2:#73707a; --text3:#b2afb8;
  --sep:rgba(60,60,67,.12); --fill:#f1ece6; --tint:#e9557a; --tint-deep:#cf3f66; --danger:#e0352b;
  --grad:linear-gradient(135deg,#ff8a5c 0%,#ef5a7c 52%,#a66bf0 100%);
  --tint-soft:rgba(233,85,122,.11);
  --sans:'Pretendard',-apple-system,BlinkMacSystemFont,'Apple SD Gothic Neo','Malgun Gothic','Noto Sans KR',sans-serif;
  --fs:12;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{height:100%;margin:0}
body{font-family:var(--sans);color:var(--text);background:#15110b;display:flex;align-items:center;justify-content:center;overscroll-behavior:none;-webkit-user-select:none;user-select:none;-webkit-text-size-adjust:100%;font-size:16px;line-height:1.45}
button{font:inherit;color:inherit;cursor:pointer;border:0;background:none;padding:0;margin:0}
button:focus-visible{outline:2px solid var(--tint);outline-offset:2px;border-radius:8px}
input,textarea{font:inherit;color:inherit}
input:focus,textarea:focus{outline:none}
*{scrollbar-width:none}
*::-webkit-scrollbar{display:none}
#app{position:relative;width:100%;height:100dvh;max-width:430px;overflow:hidden;background:#eaf0f7}
@media (min-width:560px){
  body{background:radial-gradient(circle at 30% 20%,#2a241a,#100d08)}
  #app{height:min(calc(100dvh - 40px),900px);border-radius:44px;border:10px solid #0d0b07;box-shadow:0 30px 80px rgba(0,0,0,.6),0 0 0 2px #2a251c}
}
@media (prefers-reduced-motion:reduce){*{animation-duration:.01ms!important;transition-duration:.01ms!important}}

/* ---------- 지도 ---------- */
#mapwrap{position:absolute;inset:0;overflow:hidden;
  background:radial-gradient(ellipse at 50% 40%,#f5f8fc 0%,#eaf0f7 55%,#e1e8f2 100%)}
.layer{position:absolute;inset:0;width:100%;height:100%;display:block;pointer-events:none}
#topL{pointer-events:auto;touch-action:none;cursor:grab}
#topL:active{cursor:grabbing}
.land{fill:#fbfaf6}
.nkf{fill:url(#hatch)}
.dy{fill:none;stroke:none}
.dy.v{animation:dyein .9s ease-out}
@keyframes dyein{from{fill-opacity:0}to{fill-opacity:1}}
.rg{fill:rgba(0,0,0,0);pointer-events:all;stroke:#b9b2a6;stroke-width:.7px;stroke-opacity:.9;vector-effect:non-scaling-stroke;stroke-linejoin:round}
.rg.v{stroke:rgba(255,255,255,.95);stroke-width:1px;stroke-opacity:1}
.rg.ghost{pointer-events:none}
#topL:not(.lo) .rg.ghost{stroke:none}
#topL.lo .rg.sp{stroke:none}
.rg.alias{stroke-opacity:.35}
.nk{fill:rgba(0,0,0,0);pointer-events:all;stroke:#c3bdb3;stroke-width:.8px;stroke-dasharray:4 3;vector-effect:non-scaling-stroke;stroke-linejoin:round}
#selPath{fill:none;stroke:#1d1d1f;stroke-width:2.2px;vector-effect:non-scaling-stroke;stroke-linejoin:round;pointer-events:none}
#labels{font-size:calc(var(--fs)*1px);pointer-events:none;font-family:var(--sans);font-weight:600}
.lb{text-anchor:middle;dominant-baseline:central;fill:#55595e;stroke:rgba(255,255,255,.92);stroke-width:calc(var(--fs)*.28px);paint-order:stroke fill;stroke-linejoin:round;letter-spacing:-.01em;transform-box:fill-box;transform-origin:center}
.lb.v{fill:#2b2f33}
.lb.lt{fill:#fff;stroke:rgba(0,0,0,.28)}
.lb.nk{fill:#a19b92;stroke:rgba(255,255,255,.7);stroke-width:calc(var(--fs)*.14px);font-weight:500;letter-spacing:.04em}
.lb.pop{animation:lbpop .8s ease-out}
@keyframes lbpop{0%{transform:scale(1.4);opacity:0}100%{transform:none;opacity:1}}
/* 지도 위 둥근 배경 없는 버튼: 왼쪽 위 찾기, 오른쪽 위 처음 위치 */
.mbtn{position:absolute;top:calc(env(safe-area-inset-top) + 10px);z-index:4;width:52px;height:52px;display:flex;align-items:center;justify-content:center;color:var(--tint);filter:drop-shadow(0 1px 1px rgba(255,255,255,.9)) drop-shadow(0 3px 6px rgba(30,40,50,.22));transition:opacity .22s,transform .22s}
.mbtn:active{opacity:.6}
#home{right:8px;top:auto;bottom:calc(env(safe-area-inset-bottom) + 64px);opacity:0;transform:scale(.8);pointer-events:none}
#app:has(#peek.on) #home,#app:has(#tossUI.on) #home{opacity:0;pointer-events:none}
#home.on{opacity:1;transform:none;pointer-events:auto}
#home svg{width:38px;height:38px;fill:var(--tint);stroke:none}
#sbtn{right:8px}
#tossX{right:8px;display:none}
#tossX svg{width:26px;height:26px;fill:none;stroke:var(--text);stroke-width:2.4;stroke-linecap:round}
#app.toss #tossX{display:flex}
#app.toss:has(#tossUI.on) #tossX{display:none}
.res .cx{position:absolute;right:10px;top:10px;width:30px;height:30px;border-radius:50%;background:var(--fill);color:var(--text2);display:flex;align-items:center;justify-content:center}
.res .cx svg{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:2.4;stroke-linecap:round}
.res.hasx{padding-right:48px}
#sbtn svg{width:30px;height:30px;fill:none;stroke:var(--tint);stroke-width:2.4;stroke-linecap:round}
.hint{position:absolute;left:50%;transform:translateX(-50%);bottom:calc(env(safe-area-inset-bottom) + 84px);z-index:4;display:flex;align-items:center;gap:10px;background:var(--grad);color:#fff;border-radius:22px;padding:10px 8px 10px 16px;font-size:14px;font-weight:500;white-space:nowrap;box-shadow:0 6px 20px rgba(0,0,0,.2);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px)}
.hint button{width:26px;height:26px;border-radius:50%;background:rgba(255,255,255,.18);font-size:15px;line-height:1;color:#fff;display:flex;align-items:center;justify-content:center}
.hint[hidden]{display:none}

/* ---------- 탭 바 ---------- */
#bottom{position:absolute;left:0;right:0;bottom:0;z-index:3;padding:0 0 env(safe-area-inset-bottom);background:rgba(250,247,243,.84);-webkit-backdrop-filter:blur(22px) saturate(1.6);backdrop-filter:blur(22px) saturate(1.6);border-top:1px solid rgba(60,60,67,.18)}
.tabs{display:flex;height:52px}
.tabs button{flex:1;display:flex;align-items:center;justify-content:center;color:#4f4c57}
.tabs button svg{width:25px;height:25px;stroke:currentColor;fill:none;stroke-width:1.45;stroke-linecap:round;stroke-linejoin:round}
.tabs button:active{color:var(--tint)}

/* ---------- 페이지 ---------- */
.page{position:absolute;inset:0;z-index:10;background:var(--bg);transform:translateX(104%);transition:transform .32s cubic-bezier(.2,.8,.2,1);display:flex;flex-direction:column;box-shadow:-12px 0 30px rgba(0,0,0,.12)}
.page.open{transform:none}
.nav{flex:none;position:relative;height:calc(env(safe-area-inset-top) + 48px);padding-top:env(safe-area-inset-top);display:flex;align-items:center;justify-content:center;background:rgba(250,247,243,.92);-webkit-backdrop-filter:blur(20px);backdrop-filter:blur(20px);border-bottom:1px solid transparent;transition:border-color .2s;z-index:2}
.nav.line{border-bottom-color:var(--sep)}
.nav .back{position:absolute;left:4px;top:env(safe-area-inset-top);height:48px;max-width:40%;display:flex;align-items:center;gap:1px;padding:0 10px 0 6px;color:var(--tint);font-size:17px;font-weight:400;border-radius:10px;white-space:nowrap;overflow:hidden}
.nav .back svg{flex:none;width:14px;height:22px;stroke:currentColor;fill:none;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}
.nav .back span{overflow:hidden;text-overflow:ellipsis}
.nav .back:active,.nav .act:active{opacity:.5}
.nav .act{position:absolute;right:6px;top:env(safe-area-inset-top);height:48px;min-width:44px;padding:0 12px;display:flex;align-items:center;justify-content:center;color:var(--tint);font-size:17px;font-weight:500;border-radius:10px}
.nav .act svg{width:26px;height:26px;stroke:currentColor;fill:none;stroke-width:2.2;stroke-linecap:round}
.nav .act[hidden]{display:none}
.nav .act.more{right:auto;left:auto;min-width:40px;padding:0 6px}
.nav .act.more svg{fill:currentColor;stroke:none}
.nav:has(#pact:not([hidden])) .act.more{right:50px}
.nav:not(:has(#pact:not([hidden]))) .act.more{right:6px}
.nav .ttl{font-size:17px;font-weight:600;color:var(--text);opacity:0;transition:opacity .2s;max-width:50%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.nav.line .ttl{opacity:1}
.pbody{flex:1;min-height:0;overflow-y:auto;overscroll-behavior:contain;padding:6px 16px calc(env(safe-area-inset-bottom) + 40px);-webkit-user-select:text;user-select:text}
.lt{margin:10px 0 2px;font-size:36px;font-weight:800;letter-spacing:-.035em;line-height:1.15;display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}
.lt small{font-size:15px;font-weight:400;color:var(--text2);letter-spacing:0}
.desc{font-size:15.5px;color:var(--text);margin:6px 0 0;line-height:1.5}
.cap{font-size:14px;color:var(--text2);margin:2px 0 16px}
.btn{display:flex;align-items:center;justify-content:center;width:100%;height:52px;border-radius:16px;background:var(--grad);color:#fff;font-size:17px;font-weight:700;letter-spacing:-.01em;box-shadow:0 8px 20px rgba(239,90,124,.25)}
.btn:active{filter:brightness(.92)}
.btn.sec{background:var(--tint-soft);color:var(--tint);box-shadow:none}
.btn.sec:active{background:#dcdad3}
.btn:disabled{opacity:.5}
.group{background:var(--card);border-radius:18px;overflow:hidden;margin:8px 0 24px}
.ghd{font-size:13px;color:var(--text2);margin:22px 16px 7px;font-weight:400;letter-spacing:-.01em}
.row{display:flex;align-items:center;gap:12px;min-height:46px;padding:9px 16px;width:100%;text-align:left;font-size:16.5px;position:relative;background:var(--card)}
.row+.row::before{content:"";position:absolute;left:16px;right:0;top:0;border-top:1px solid var(--sep)}
.row:active{background:var(--fill)}
.row .sp{flex:1;min-width:0;display:flex;align-items:baseline;gap:8px}
.row .sp em{font-style:normal;font-size:13px;color:var(--text2)}
.row .v{color:var(--text2);font-size:15px;flex:none}
.row .chev{flex:none;width:8px;height:14px;stroke:var(--text3);fill:none;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}
.row .chk{flex:none;width:20px;height:20px;stroke:var(--tint);fill:none;stroke-width:2.6;stroke-linecap:round;stroke-linejoin:round;visibility:hidden}
.row.on .chk{visibility:visible}
.row.tint{color:var(--tint);justify-content:center;font-weight:500}
.row.danger{color:var(--danger);justify-content:center;font-weight:500}
.dot{display:inline-block;width:12px;height:12px;border-radius:50%;border:1px solid rgba(0,0,0,.1);background:var(--paper-light);flex:none}
.search{display:flex;align-items:center;gap:7px;background:var(--fill);border-radius:14px;height:40px;padding:0 10px;margin:8px 0 4px}
.search svg{width:17px;height:17px;stroke:var(--text2);fill:none;stroke-width:2;flex:none}
.search input{flex:1;min-width:0;border:0;background:none;font-size:16.5px;color:var(--text);-webkit-user-select:text;user-select:text}
.search input::placeholder{color:var(--text3)}
.note{font-size:13px;color:var(--text2);line-height:1.55;margin:-14px 16px 22px}
.seg{display:flex;background:rgba(118,118,128,.12);border-radius:9px;padding:2px}
.seg button{flex:1;border:0;background:none;font:inherit;font-size:15px;padding:7px 0;border-radius:7px;color:var(--text)}
.seg button.on{background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.12);font-weight:600}
.warn{background:#fff3e8;border-radius:12px;padding:11px 14px;font-size:13.5px;color:#8a4b12;line-height:1.5;margin:-10px 0 20px}
.sw8{display:flex;gap:4px;flex:1;max-width:190px;margin-left:auto}
.sw8 i{flex:1;height:20px;border-radius:5px}
.nkbox{font-size:15px;line-height:1.6;color:var(--text2);padding:4px 2px 18px}
.foot{font-size:12.5px;color:var(--text3);text-align:center;margin:10px 0}
.empty{color:var(--text2);font-size:14px;text-align:center;padding:26px 0}

/* 지역 페이지: 글 목록(블로그처럼) */
.post{display:flex;gap:12px;align-items:flex-start;padding:12px 16px;width:100%;text-align:left;background:var(--card);position:relative}
.post+.post::before{content:"";position:absolute;left:16px;right:0;top:0;border-top:1px solid var(--sep)}
.post:active{background:var(--fill)}
.post .pm{flex:1;min-width:0}
.post .pd{font-size:13px;color:var(--text2);margin-bottom:3px}
.post .pe{font-size:16px;line-height:1.45;color:var(--text);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;overflow-wrap:anywhere;white-space:pre-line}
.post .pe.ph{color:var(--text2)}
.post .pt-t{font-size:16.5px;font-weight:700;letter-spacing:-.02em;margin-bottom:2px}
.post .pe.one{-webkit-line-clamp:1;font-size:14.5px;color:var(--text2)}
.pstrip{display:grid;grid-template-columns:repeat(4,1fr);gap:4px;margin:14px 0 6px}
.pstrip .pt{border-radius:12px}
.pstrip .pt.more{display:flex;flex-direction:column;align-items:center;justify-content:center;background:var(--fill);color:var(--text2);gap:2px}
.pstrip .pt.more b{font-size:18px;color:var(--text)}
.pstrip .pt.more span{font-size:11.5px}
.post img{flex:none;width:64px;height:64px;border-radius:14px;object-fit:cover;background:#e3e1db}
/* 글 페이지 */
.ptx{white-space:pre-wrap;font-size:17px;line-height:1.7;margin:0 0 14px;overflow-wrap:anywhere;color:var(--text)}
.pimg{display:block;width:100%;border-radius:18px;margin:4px 0 16px;background:#e3e1db;cursor:zoom-in}
.pbody .first{margin-top:18px}
.pgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:2px;margin:4px -16px 0}
.pt{position:relative;aspect-ratio:1;overflow:hidden;background:#e3e1db}
.pt img{width:100%;height:100%;object-fit:cover;display:block}
.pt:active img{opacity:.8}
.pt .tag{position:absolute;right:5px;top:5px;max-width:80%;padding:2px 6px;border-radius:7px;background:rgba(29,29,31,.55);color:#fff;font-size:10px;font-weight:500;letter-spacing:-.01em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px)}

/* ---------- 에디터(모달 시트) ---------- */
#editor{position:absolute;inset:0;z-index:20;background:var(--bg);transform:translateY(104%);transition:transform .34s cubic-bezier(.2,.8,.2,1);display:flex;flex-direction:column}
#editor.open{transform:none}
.edh{flex:none;height:calc(env(safe-area-inset-top) + 50px);padding:env(safe-area-inset-top) 8px 0;display:flex;align-items:center;justify-content:space-between;background:rgba(250,247,243,.92);border-bottom:1px solid var(--sep)}
.edh h3{margin:0;font-size:17px;font-weight:600;display:flex;align-items:baseline;gap:6px;max-width:50%;white-space:nowrap;overflow:hidden}
.edh h3 small{font-size:13px;font-weight:400;color:var(--text2)}
.edh button{height:44px;padding:0 10px;color:var(--tint);font-size:17px;border-radius:10px}
.edh button.save{font-weight:600}
.edh button:disabled{color:var(--text3)}
.edb{flex:1;overflow-y:auto;padding:10px 16px 20px;-webkit-user-select:text;user-select:text}
.cell{background:var(--card);border-radius:16px;padding:12px 16px;margin:0 0 12px}
.cell.row2{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:50px;padding:4px 16px}
.cell label{font-size:16.5px;color:var(--text)}
.cell label .lsub{display:block;font-size:12px;color:var(--text3);margin-top:1px}
.cell.row2 .sw{width:auto;padding:0;background:none}
.lock{display:inline-block;width:13px;height:13px;vertical-align:-1px;margin-right:4px;stroke:var(--text3);fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.dval{display:flex;align-items:center;gap:6px;height:42px;padding:0 2px 0 10px;font-size:16px;color:var(--text);font-weight:500}
.dval svg{width:8px;height:14px;stroke:var(--text3);fill:none;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}
.dval:active{opacity:.5}
.blocks{background:var(--card);border-radius:16px;padding:6px 16px 10px;margin:0 0 12px}
.blocks textarea{width:100%;border:0;background:none;resize:none;font-size:17px;line-height:1.65;color:var(--text);display:block;padding:8px 0;min-height:46px;overflow:hidden}
.blocks textarea.first{min-height:150px}
.blocks textarea::placeholder{color:var(--text3)}
.ib{position:relative;margin:4px 0 8px}
.ib img{display:block;width:100%;max-height:360px;object-fit:cover;border-radius:16px;background:#e3e1db}
.ib .rm{position:absolute;right:8px;top:8px;width:30px;height:30px;border-radius:50%;background:rgba(29,29,31,.72);color:#fff;display:flex;align-items:center;justify-content:center}
.ib .rm svg{width:15px;height:15px;stroke:#fff;fill:none;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}
.ib .fl{display:flex;gap:6px;margin:6px 0 0;min-height:18px}
.ib .fl span{font-size:12px;color:var(--text2);background:var(--fill);padding:3px 9px;border-radius:10px}
#edPhoto{position:absolute;right:18px;bottom:calc(env(safe-area-inset-bottom) + 18px);width:56px;height:56px;border-radius:50%;background:var(--grad);color:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 10px 24px rgba(239,90,124,.35);z-index:3}
#edPhoto svg{width:26px;height:26px;stroke:currentColor;fill:none;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}
#edPhoto:active{transform:scale(.94)}
.edb{padding-bottom:110px}
.cell.row2 .regs{flex:1;min-width:0;display:flex;flex-wrap:nowrap;overflow-x:auto;gap:6px;justify-content:flex-end;padding:6px 0}
.cell.row2 .regs .chip{flex:none}
.chip.add.pl{width:30px;height:30px;padding:0;border-radius:50%;justify-content:center;font-size:20px;line-height:1}
.dates{display:flex;align-items:center;gap:2px;flex:1;min-width:0;justify-content:flex-end}
.dates .dval{padding:0 2px 0 4px;font-size:15.5px}
.dates.on .dval{font-size:14.5px;letter-spacing:-.02em}
.cell.row2 label{flex:none}
.dates .dash{color:var(--text3)}
.rng{flex:none;font-size:12.5px;padding:5px 10px;border-radius:12px;background:var(--fill);color:var(--text2)}
.rng.on{background:var(--tint-soft);color:var(--tint)}
.ttl-in{width:100%;border:0;background:none;font-size:19px;font-weight:700;letter-spacing:-.02em;padding:10px 0 6px;color:var(--text)}
.ttl-in::placeholder{color:var(--text3);font-weight:600}
.alg{display:flex;justify-content:flex-end;gap:2px;margin:0 -6px 2px 0}
.alg button{width:32px;height:28px;border-radius:8px;display:flex;align-items:center;justify-content:center;color:var(--text3)}
.alg button.on{background:var(--fill);color:var(--text)}
.alg svg{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round}
.blocks.al-c textarea,.blocks.al-c .ttl-in{text-align:center}
.blocks.al-r textarea,.blocks.al-r .ttl-in{text-align:right}
.ptx.al-c,.pt-ti.al-c{text-align:center}
.ptx.al-r,.pt-ti.al-r{text-align:right}
.pt-ti{font-size:24px;font-weight:800;letter-spacing:-.03em;line-height:1.25;margin:0 0 10px}
.ib.drag{opacity:.85;z-index:5;position:relative;box-shadow:0 14px 34px rgba(0,0,0,.22);border-radius:16px;transition:none}
.ib.lift{transform:scale(.97);transition:transform .15s}
.ib .hint2{position:absolute;left:0;right:0;bottom:8px;text-align:center;font-size:11.5px;color:#fff;text-shadow:0 1px 3px rgba(0,0,0,.5);pointer-events:none}
.edb.dragging{overflow:hidden}
.crop{position:relative;width:100%;overflow:hidden;border-radius:16px;background:#e3e1db}
.crop img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;border-radius:0;max-height:none}
.crop.r11{aspect-ratio:1/1}.crop.r43{aspect-ratio:4/3}.crop.r169{aspect-ratio:16/9}
.pimg.crop{margin:4px 0 16px}

/* 날짜 고르기 (고지도풍) */
.mbox.cal{max-width:330px;text-align:left;padding:14px 12px 8px;background:#fff}
.cal .ch{display:flex;align-items:center;justify-content:space-between;padding:2px 4px 10px}
.cal .ch button.ym{width:auto;height:38px;white-space:nowrap;display:flex;align-items:center;gap:6px;font-size:19px;font-weight:700;color:var(--text);letter-spacing:-.01em;padding:6px 10px;border-radius:10px}
.cal .ch .ym svg{width:8px;height:14px;stroke:var(--tint);fill:none;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round;transition:transform .2s}
.cal .ch .ym.open svg{transform:rotate(90deg)}
.cal .ch .ym:active{background:rgba(60,40,15,.08)}
.cal .gd.months{grid-template-columns:repeat(3,1fr);row-gap:8px;column-gap:8px;padding:6px 0 10px;min-height:258px;align-content:start}
.cal .gd.months button{height:52px;border-radius:12px;font-size:17px}
.cal .gd.months button.sel{background:var(--grad);color:#fff}
.cal .ch button{width:38px;height:38px;border-radius:50%;color:var(--ink2);font-size:22px;line-height:1}
.cal .ch button:active{background:rgba(60,40,15,.08)}
.cal .wd{display:grid;grid-template-columns:repeat(7,1fr);font-size:12px;color:var(--text2);text-align:center;margin-bottom:4px;letter-spacing:.05em}
.cal .wd span:first-child{color:#b23a2b}
.cal .gd{display:grid;grid-template-columns:repeat(7,1fr);row-gap:3px;min-height:258px;align-content:start}
.cal .gd button{height:40px;border-radius:50%;font-size:16.5px;color:var(--text);font-weight:500}
.cal .gd button.sun{color:#b23a2b}
.cal .gd button.today{box-shadow:inset 0 0 0 1.5px var(--tint)}
.cal .gd button.sel{background:var(--grad);color:#fff;box-shadow:none}
.cal .gd button:disabled{opacity:.22}
.cal .gd button:not(:disabled):active{background:rgba(60,40,15,.12)}
.cal .cf{display:flex;justify-content:space-between;align-items:center;padding:10px 4px 2px;font-size:14.5px}
.cal .cf button{color:var(--tint);padding:8px 10px;font-weight:500;border-radius:8px}

/* ---------- 찾기 팝업 ---------- */
#spop{position:absolute;inset:0;z-index:12;background:rgba(24,22,34,.3);display:none;opacity:0;transition:opacity .18s}
#spop.open{display:block}
#spop.in{opacity:1}
.sheet{position:absolute;left:10px;right:10px;top:calc(env(safe-area-inset-top) + 10px);max-height:64%;display:flex;flex-direction:column;background:rgba(252,250,248,.98);border-radius:22px;box-shadow:0 18px 50px rgba(20,20,30,.22);overflow:hidden;transform:translateY(-14px) scale(.98);transition:transform .22s cubic-bezier(.2,.8,.2,1)}
#spop.in .sheet{transform:none}
.sbar{flex:none;display:flex;align-items:center;gap:6px;padding:10px 14px 8px 12px}
.sbar .search{flex:1;margin:0;background:var(--fill)}
.sbar button{color:var(--tint);font-size:16px;font-weight:500;padding:0 6px;height:38px;flex:none}
.sres{flex:1;min-height:0;overflow-y:auto;padding:0 10px 12px}
.sres .ghd{margin:12px 10px 6px}
.sres .ghd:first-child{margin-top:2px}
.sres .group{margin:0 0 6px;background:var(--fill);border-radius:14px}
.sres .row{background:transparent}
.sres .row:active{background:rgba(0,0,0,.05)}
.sres .empty{padding:18px 0 14px}

/* ---------- 어디로: 펜 던지기 · 추천 ---------- */
.go{display:flex;align-items:center;gap:14px;padding:14px 16px;width:100%;text-align:left;background:var(--card);position:relative}
.go+.go::before{content:"";position:absolute;left:68px;right:0;top:0;border-top:1px solid var(--sep)}
.go:active{background:var(--fill)}
.go .ic{flex:none;width:40px;height:40px;border-radius:11px;display:flex;align-items:center;justify-content:center;color:#fff}
.go .ic svg{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.go .tt{flex:1;min-width:0}
.go .tt b{display:block;font-size:16.5px;font-weight:600}
.go .tt span{display:block;font-size:13px;color:var(--text2);margin-top:1px}
.sw{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:11px 16px;width:100%;text-align:left;background:var(--card);font-size:16px;position:relative}
.tog{flex:none;width:51px;height:31px;border-radius:16px;background:#d9d7d0;position:relative;transition:background .2s}
.tog::after{content:"";position:absolute;left:2px;top:2px;width:27px;height:27px;border-radius:50%;background:#fff;box-shadow:0 2px 5px rgba(0,0,0,.2);transition:transform .2s}
.tog.on{background:var(--tint)}
.tog.on::after{transform:translateX(20px)}
.chip{display:inline-flex;align-items:center;padding:7px 13px;border-radius:17px;background:var(--fill);font-size:14px;color:var(--text);font-weight:500}
.regs{display:flex;flex-wrap:wrap;gap:6px}
.chip.rg{gap:4px;padding:6px 10px 6px 12px}
.chip.rg.main{background:var(--grad);color:#fff;padding-right:12px}
.chip.rg button{width:18px;height:18px;border-radius:50%;background:rgba(0,0,0,.12);font-size:12px;line-height:1;display:flex;align-items:center;justify-content:center}
.chip.add{color:var(--tint);background:var(--tint-soft)}
.lnk{display:block;color:var(--tint);font-size:14px;padding:10px 0 0;font-weight:500}
.mbox.pick{max-width:340px;text-align:left}
.mbox.pick h4{text-align:center}
.mbox.pick .pl{max-height:46vh;overflow-y:auto;margin:0 12px 8px;border-radius:12px}
.mbox.pick .row{min-height:44px;font-size:16px}
.res{background:var(--card);border-radius:20px;padding:16px 18px;margin:12px 0;position:relative}
.res .nm{font-size:26px;font-weight:800;letter-spacing:-.03em;display:flex;align-items:baseline;gap:8px}
.res .nm small{font-size:14px;font-weight:400;color:var(--text2)}
.res .nm .rk{color:var(--tint);font-size:20px;margin-right:2px}
.res .ds{font-size:15px;margin:4px 0 2px}
.res .why{font-size:13px;color:var(--text2);margin-top:4px}
.res .rb{display:flex;gap:8px;margin-top:12px}
.res .rb .btn{height:44px;font-size:15px;border-radius:14px}
/* 펜 던지기 모드 */
#tossBtn{position:absolute;left:50%;bottom:calc(env(safe-area-inset-bottom) + 92px);transform:translateX(-50%);width:128px;height:128px;border-radius:50%;background:var(--grad);color:#fff;font-size:23px;font-weight:800;letter-spacing:-.01em;box-shadow:0 14px 34px rgba(239,90,124,.42),0 0 0 10px rgba(239,90,124,.14);z-index:5;display:none;transition:transform .15s}
#tossBtn:active{transform:translateX(-50%) scale(.94);filter:brightness(.92)}
#app.toss.idle #tossBtn{display:block}
#app.toss #sbtn,#app.toss #home,#app.toss .hint{display:none}
#tossUI,#peek{position:absolute;left:14px;right:14px;bottom:calc(env(safe-area-inset-bottom) + 68px);z-index:5;display:none}
#tossUI.on,#peek.on{display:block}
#peek .res{margin:0;width:100%;text-align:left;background:rgba(255,255,255,.96);-webkit-backdrop-filter:blur(16px);backdrop-filter:blur(16px);box-shadow:0 8px 30px rgba(40,28,10,.18);padding-right:40px;animation:peekin .22s ease-out}
#peek .res:active{background:rgba(240,238,232,.96)}
#peek .chev{position:absolute;right:18px;top:50%;transform:translateY(-50%);width:8px;height:14px;stroke:var(--text3);fill:none;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}
@keyframes peekin{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
#app.toss #peek{display:none}
#tossUI .res{margin:0;background:rgba(255,255,255,.94);-webkit-backdrop-filter:blur(16px);backdrop-filter:blur(16px);box-shadow:0 8px 30px rgba(40,28,10,.18)}
#marker{position:absolute;left:0;top:0;width:44px;height:44px;z-index:6;pointer-events:none;display:none;margin:-36px 0 0 -8px}
#marker svg{width:44px;height:44px;display:block;filter:drop-shadow(0 6px 6px rgba(0,0,0,.3))}
#pin{pointer-events:none}
#pin .splash{fill:none;stroke:#1d1d1f;stroke-width:1.5px;vector-effect:non-scaling-stroke;opacity:0}
#pin.on .splash{animation:splash .8s ease-out forwards}
@keyframes splash{0%{r:2px;opacity:.9}100%{r:16px;opacity:0}}
#pin .xo{fill:none;stroke:#fff;stroke-width:5px;stroke-linecap:round;vector-effect:non-scaling-stroke}
#pin .xi{fill:none;stroke:#1d1d1f;stroke-width:2.4px;stroke-linecap:round;vector-effect:non-scaling-stroke}
/* 추천 질문 */
.prog{display:flex;gap:5px;margin:10px 0 18px}
.prog i{flex:1;height:3px;border-radius:2px;background:var(--fill)}
.prog i.on{background:var(--grad)}
.qn{font-size:13px;color:var(--text2);margin:0 0 6px;font-weight:500}
.qq{font-size:30px;font-weight:800;letter-spacing:-.03em;line-height:1.25;margin:0 0 18px}
.opt{display:flex;align-items:center;justify-content:space-between;gap:10px;width:100%;text-align:left;padding:15px 18px;background:var(--card);font-size:17px;font-weight:500;position:relative}
.opt+.opt::before{content:"";position:absolute;left:18px;right:0;top:0;border-top:1px solid var(--sep)}
.opt:active{background:var(--fill)}
.opt .chk{flex:none;width:22px;height:22px;border-radius:50%;padding:4px;stroke:#fff;fill:none;stroke-width:2.6;stroke-linecap:round;stroke-linejoin:round;background:var(--fill);visibility:visible;box-sizing:border-box}
.opt.on{color:var(--tint)}
.opt.on .chk{background:var(--grad)}
.pbody .btn[hidden]{display:none}
.group+.btn{margin-top:-12px;margin-bottom:16px}
.prev{display:inline-flex;align-items:center;gap:4px;color:var(--tint);font-size:15px;padding:10px 0;font-weight:500}
.prev svg{width:10px;height:16px;stroke:currentColor;fill:none;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}

/* ---------- 현황 ---------- */
.hero{background:var(--card);border-radius:20px;padding:18px 18px 16px;margin:8px 0 10px}
.hero .top{display:flex;align-items:center;gap:16px}
.hero svg{width:112px;height:142px;flex:none}
.hero .hn{font-size:64px;font-weight:800;letter-spacing:-.05em;line-height:1;color:var(--text)}
.hero .hn .gn{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.hero .hn small{font-family:var(--sans);font-size:16px;font-weight:500;color:var(--text2);margin-left:5px;letter-spacing:0}
.hero .hs{font-size:14px;color:var(--text2);margin-top:6px}
.bar{height:8px;border-radius:4px;background:var(--fill);overflow:hidden;margin-top:14px}
.bar i{display:block;height:100%;border-radius:4px;background:var(--grad);transition:width .6s ease-out}
.tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:0 0 20px}
.tile{background:var(--card);border-radius:16px;padding:12px 12px 10px}
.tile b{display:block;font-size:24px;font-weight:700;letter-spacing:-.03em;line-height:1.1}
.tile b em{font-style:normal;font-family:var(--sans);font-size:12px;font-weight:500;color:var(--text2);margin-left:2px}
.tile span{display:block;font-size:12px;color:var(--text2);margin-top:4px}
.sd{display:grid;grid-template-columns:38px 1fr 56px;gap:10px;align-items:center;font-size:15px;width:100%}
.row.slim{min-height:40px;padding:6px 16px}
.sd .b{height:6px;border-radius:3px;background:var(--fill);overflow:hidden}
.sd .b i{display:block;height:100%;border-radius:3px;background:var(--grad)}
.sd span:last-child{text-align:right;color:var(--text2);font-size:13px;font-variant-numeric:tabular-nums}
.sd.done span:first-child{color:var(--tint);font-weight:600}
.kv{display:flex;justify-content:space-between;align-items:baseline;gap:12px;padding:12px 16px;background:var(--card);position:relative;font-size:16px}
.kv+.kv::before{content:"";position:absolute;left:16px;right:0;top:0;border-top:1px solid var(--sep)}
.kv span{color:var(--text2);font-size:14px;flex:none}
.kv b{font-weight:600;text-align:right;min-width:0;overflow-wrap:anywhere}

/* ---------- 모달·토스트 ---------- */
#modal{position:absolute;inset:0;z-index:40;background:rgba(0,0,0,.4);display:none;align-items:center;justify-content:center;padding:28px}
#modal.open{display:flex}
.mbox{width:100%;max-width:300px;max-height:100%;overflow:auto;background:rgba(252,250,248,.97);-webkit-backdrop-filter:blur(20px);backdrop-filter:blur(20px);border-radius:22px;box-shadow:0 20px 60px rgba(0,0,0,.3);text-align:center}
.mbox h4{margin:0;padding:20px 18px 6px;font-size:17px;font-weight:600}
.mbox p{margin:0;padding:0 18px 18px;font-size:13.5px;line-height:1.5;color:var(--text2)}
.mbox .acts{display:flex;border-top:1px solid var(--sep)}
.mbox .acts button{flex:1;height:46px;font-size:17px;color:var(--tint);border-left:1px solid var(--sep)}
.mbox .acts button:first-child{border-left:0}
.mbox .acts button.b{font-weight:600}
.mbox .acts button.d{color:var(--danger)}
.mbox .acts.col{flex-direction:column}
.mbox .acts.col button{border-left:0;border-top:1px solid var(--sep)}
.mbox .acts.col button:first-child{border-top:0}
.mbox .acts button:active{background:rgba(0,0,0,.05)}
.mbox.share{max-width:340px}
.mbox.share .story{display:block;width:100%;max-height:52vh;object-fit:contain;margin:0 auto}
.mbox.view{background:#000;max-width:none;height:100%;display:flex;flex-direction:column;border-radius:0}
.mbox.view .vi{flex:1;min-height:0;display:flex;align-items:center;justify-content:center;position:relative}
.mbox.view img{max-width:100%;max-height:100%;object-fit:contain}
.mbox.view .vn{position:absolute;top:50%;transform:translateY(-50%);width:44px;height:64px;background:rgba(255,255,255,.12);color:#fff;font-size:24px}
.mbox.view .vc{flex:none;color:#ddd;font-size:13px;text-align:center;padding:12px}
#toast{position:absolute;left:50%;bottom:calc(env(safe-area-inset-bottom) + 76px);transform:translate(-50%,10px);background:rgba(29,29,31,.9);color:#fff;padding:11px 18px;border-radius:24px;font-size:14px;z-index:60;opacity:0;pointer-events:none;transition:.25s;width:max-content;max-width:86%;text-align:center;word-break:keep-all;-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px)}
#toast.on{opacity:1;transform:translate(-50%,0)}
input[type=file]{display:none}
/* ---------- 인트로 ---------- */
#intro{position:absolute;inset:0;z-index:70;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0;padding:0 28px calc(env(safe-area-inset-bottom) + 20px);color:#fff;text-align:center;background:linear-gradient(160deg,#ffb347 0%,#ff6a6a 30%,#ef3f7f 55%,#9b4dff 100%);transition:opacity .45s,visibility .45s}
#intro[hidden]{display:flex;opacity:0;visibility:hidden;pointer-events:none}
#intro .wm{display:flex;align-items:baseline;gap:0;font-size:60px;font-weight:800;letter-spacing:-.045em;line-height:1;text-shadow:0 6px 24px rgba(0,0,0,.18);animation:wmin .9s cubic-bezier(.2,.8,.2,1) both}
#intro .wm svg{fill:#fff;stroke:#fff;stroke-width:.012;stroke-linejoin:round;filter:drop-shadow(0 8px 18px rgba(0,0,0,.2));margin-left:-.03em;overflow:visible}
#intro p{margin:18px 0 0;font-size:16px;line-height:1.6;opacity:.92;animation:wmin 1s .15s cubic-bezier(.2,.8,.2,1) both}
#intro button{position:absolute;inset:0;background:none}
@keyframes wmin{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
</style>
</head>
