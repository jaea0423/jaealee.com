function openReco(){
  const ans={};let step=0;
  openPage('reco','당신을 위한 추천',body=>{
    const draw=()=>{
      body.replaceChildren();
      if(step>=QS.length){renderReco(body,ans,()=>{step=0;for(const k in ans)delete ans[k];draw();});return;}
      const q=QS[step];const cur=ans[q.k]||(ans[q.k]=q.multi?[]:null);
      body.append(h('div',{class:'prog'},QS.map((_,i)=>h('i',{class:i<=step?'on':''}))),
        h('div',{class:'qn'},(step+1)+' / '+QS.length+(q.multi?' · 여러 개 골라도 돼요':'')),h('div',{class:'qq'},q.q));
      const grp=h('div',{class:'group'});
      const next=h('button',{class:'btn',onclick:()=>{step++;draw();pbody.scrollTop=0;}},step===QS.length-1?'추천 보기':'다음');
      const sync=()=>{const has=q.multi?ans[q.k].length>0:ans[q.k]!=null;next.hidden=!has;
        grp.querySelectorAll('.opt').forEach(b=>b.classList.toggle('on',q.multi?ans[q.k].includes(b.dataset.v):ans[q.k]===b.dataset.v));};
      q.o.forEach(([v,l])=>grp.append(h('button',{class:'opt','data-v':v,onclick:()=>{
        if(q.multi){const a=ans[q.k];const i=a.indexOf(v);if(i<0)a.push(v);else a.splice(i,1);}else ans[q.k]=v;sync();}},l,icon('chk',CHECK,'0 0 20 20'))));
      body.append(grp,next);sync();
      if(step>0)body.append(h('button',{class:'prev',onclick:()=>{step--;draw();}},icon('',"M8 1L2 8l6 7",'0 0 10 16'),'이전 질문'));
    };
    draw();
  });
}
// 점수: 질문마다 고른 것 중 몇 개가 맞는지(비율)로 더하고, 세 질문 모두 하나 이상 맞는 곳을 우선한다
function recommend(ans){
  const v=visitedTop();
  const pool=SK.filter(r=>(!goOpts.unvisited||!v.has(r.id))&&(ans.island==='yes'||(r.t!=='i'&&r.sido!=='제주'))&&(ans.stay!=='day'||!FAR.has(r.id)));
  return pool.map(r=>{
    const t=tagsOf(r);let s=Math.random()*0.25,hits=0;
    for(const k of ['scene','mood','do']){const sel=ans[k]||[];if(!sel.length)continue;const m=sel.filter(x=>t.has(x)).length;if(m){hits++;s+=1.2*m/sel.length+0.4;}}
    s+=hits*0.6;                                            // 세 질문에 고르게 맞는 곳
    if(ans.stay==='night'&&(FAR.has(r.id)||TAGSETS.rest.has(r.id)))s+=0.3;
    if(ans.stay==='day'&&(r.t==='m'||TAGSETS.city.has(r.id)))s+=0.15;
    if(r.t==='i'&&hits<3)s-=0.5;                            // 작은 섬이 상위를 다 차지하지 않게
    return {r,s,hits};
  }).sort((a,b)=>b.s-a.s);
}
function renderReco(body,ans,again){
  const scored=recommend(ans).filter(x=>x.hits>0);
  body.append(h('div',{class:'lt'},'이런 곳은 어떠세요'),h('div',{class:'cap'},' '));
  if(!scored.length){body.append(h('div',{class:'empty'},'조건에 맞는 곳이 없습니다.'),h('button',{class:'btn sec',onclick:again},'다시 고르기'));return;}
  // 상위에서 시·도가 겹치지 않게, 섬은 한 곳까지만(후보가 넉넉할 때)
  const picks=[],sidos=new Set();let isls=0;
  for(const x of scored){if(picks.length>=3)break;if(scored.length>6&&(sidos.has(x.r.sido)||(x.r.t==='i'&&isls>=1)))continue;picks.push(x);sidos.add(x.r.sido);if(x.r.t==='i')isls++;}
  picks.forEach((x,i)=>body.append(resultCard(x.r,null,[h('button',{class:'btn sec',onclick:()=>goMap(x.r.id)},'지도에서 보기')],i+1)));
  body.append(h('button',{class:'btn sec',style:'margin-top:6px',onclick:again},'다시 고르기'));
}

