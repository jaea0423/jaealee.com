  const today=new Date();today.setHours(0,0,0,0);
  let sel=cur&&/^\d{4}-\d{2}-\d{2}$/.test(cur)?cur:todayStr();
  let y=+sel.slice(0,4),m=+sel.slice(5,7)-1,mode='day';
  const ttl=h('button',{type:'button',class:'ym','aria-label':'연도와 월 선택'});const grid=h('div',{class:'gd'});const wd=h('div',{class:'wd'},WD.map(w=>h('span',null,w)));
  const prev=h('button',{type:'button','aria-label':'이전',onclick:()=>nav(-1)},'‹'),next=h('button',{type:'button','aria-label':'다음',onclick:()=>nav(1)},'›');
  const draw=()=>{
    grid.replaceChildren();grid.className='gd'+(mode==='month'?' months':'');wd.style.visibility=mode==='day'?'':'hidden';
    ttl.replaceChildren(mode==='day'?y+'년 '+(m+1)+'월':y+'년',icon('',CHEV,'0 0 8 14'));ttl.classList.toggle('open',mode==='month');
    if(mode==='month'){
      for(let i=0;i<12;i++){grid.append(h('button',{type:'button',class:(i===m?' sel':''),onclick:()=>{m=i;mode='day';draw();}},(i+1)+'월'));}
      return;
    }
    const first=new Date(y,m,1),off=first.getDay(),days=new Date(y,m+1,0).getDate();
    for(let i=0;i<42;i++){               // 늘 6줄: 달마다 높이가 바뀌지 않게
      const d=i-off+1;
      if(d<1||d>days){grid.append(h('span'));continue;}
      const dt=new Date(y,m,d),s=ymd(dt);
      grid.append(h('button',{type:'button',class:(dt.getDay()===0?'sun':'')+(s===todayStr()?' today':'')+(s===sel?' sel':''),onclick:()=>{sel=s;closeModal();onPick(sel);}},d));
    }
  };
  const nav=(d)=>{if(mode==='month'){y+=d;draw();return;}m+=d;if(m<0){m=11;y--;}if(m>11){m=0;y++;}draw();};
  ttl.onclick=()=>{mode=mode==='day'?'month':'day';draw();};
  box.replaceChildren(
    h('div',{class:'ch'},prev,ttl,next),wd,grid,
    h('div',{class:'cf'},h('button',{type:'button',onclick:()=>{const t=todayStr();closeModal();onPick(t);}},'오늘'),h('button',{type:'button',onclick:closeModal},'닫기')));
  draw();$('#modal').classList.add('open');
}

