/* ---------- 데이터 ---------- */
const SK=MAP.regions, NKR=MAP.nk;
const SIDO_ORDER=['서울','부산','대구','인천','광주','대전','울산','세종','경기','강원','충북','충남','전북','전남','경북','경남','제주'];
const SIDO_FULL={서울:'서울특별시',부산:'부산광역시',대구:'대구광역시',인천:'인천광역시',광주:'광주광역시',대전:'대전광역시',울산:'울산광역시',세종:'세종특별자치시',경기:'경기도',강원:'강원특별자치도',충북:'충청북도',충남:'충청남도',전북:'전북특별자치도',전남:'전라남도',경북:'경상북도',경남:'경상남도',제주:'제주특별자치도',북한:'북한'};
// 이름 옆 보조 표기: "수원 경기도", "부산 광역시", 섬은 "전라남도 신안"
const subName=r=>r.nk?'북한':r.lvl==='do'?SIDO_FULL[r.sido]:r.sub===true?(byId.get(r.parent).name===r.sido?SIDO_FULL[r.sido]:SIDO_FULL[r.sido]+' '+byId.get(r.parent).name):r.p?(SIDO_FULL[r.sido]+(r.p===r.sido?'':' '+r.p)):(r.sido===r.name?SIDO_FULL[r.sido].slice(r.name.length):SIDO_FULL[r.sido]);
const descOf=r=>DESC[r.id]||(r.sub===true?DESC[r.parent]:'')||'';
const byId=new Map();
SK.forEach(r=>byId.set(r.id,Object.assign({nk:false},r)));
NKR.forEach(r=>byId.set(r.id,Object.assign({nk:true},r)));
// 구 단위 조각: 부모를 '나누기'로 켜면 부모 대신 조각들이 보인다
const SUBS=[];SK.forEach(r=>(r.sub||[]).forEach(x=>{const o=Object.assign({nk:false,sub:true,parent:r.id,lvl:'gu'},x);byId.set(x.id,o);SUBS.push(o);}));
const DO=MAP.sido.map(r=>{const o=Object.assign({nk:false,lvl:'do'},r);byId.set(o.id,o);return o;});
SK.forEach(r=>{const o=byId.get(r.id);o.lvl='si';if(r.p){o.isl=true;o.pid=r.id.split('_')[0];}});   // 섬: 소속 시·군 id
const ALL=()=>[...DO,...SK.map(r=>byId.get(r.id)),...SUBS];
const level=()=>state.settings.level;                              // 'do' | 'si' | 'gu'
const isSplit=id=>level()==='gu'?Array.isArray((byId.get(id)||{}).sub)&&byId.get(id).sub.length>0:(level()==='si'&&state.settings.split.includes(id));
const topOf=o=>o.sub===true?byId.get(o.parent):o;                 // 조각 → 부모(시·군) 지역
// 지금 설정에서 '한 지역'으로 보이는가 (지도에서 눌리고, 따로 물들고, 셈해지는 단위)
const ALWAYS_ISL=new Set(['37430_독도']);   // 섬을 합쳐도 따로 두는 섬
const isUnit=o=>{if(o.nk)return true;const lv=level();
  if(o.lvl==='do')return lv==='do';
  if(o.virt&&o.lvl==='si')return lv!=='do'&&!state.settings.islands;             // 신안처럼 본토 없는 군의 가상 본체: 섬 합칠 때만
  if(o.lvl==='gu')return isSplit(o.parent)&&(!o.virt||(lv!=='do'&&!state.settings.islands));   // 섬뿐인 구(영도구)는 섬 합칠 때만
  if(o.isl)return lv!=='do'&&(state.settings.islands||ALWAYS_ISL.has(o.id));
  return lv!=='do'&&!isSplit(o.id);};
const VIS=()=>ALL().filter(isUnit);
// 어떤 지역 id가 지금 설정에서 어느 단위로 보이는가 (기록이 셈해지는 지역). 더 큰 단위로 올라가되, 지금보다 큰 단위의 id는 그대로(=하위 미지정)
const dispId=rid=>{let o=byId.get(rid);if(!o||o.nk)return rid;const lv=level();
  if(o.lvl==='gu'){if(isSplit(o.parent))return o.id;o=byId.get(o.parent);}
  if(o.isl){if(lv!=='do'&&(state.settings.islands||ALWAYS_ISL.has(o.id)))return o.id;const par=byId.get(o.pid);if(lv!=='do'&&isSplit(par.id)&&o.g&&byId.has(o.g)&&isUnit(byId.get(o.g)))return o.g;o=par;}
  if(o.lvl==='si'){if(lv==='do')return 'do_'+o.sido;return o.id;}
  return o.id;};
const regOf=dispId;
// 하위 미지정 기록을 연하게 보여 줄 범위: 그 지역 아래에서 지금 보이는 단위들
const unitsUnder=o=>o.lvl==='do'?VIS().filter(u=>u.sido===o.sido):Array.isArray(o.sub)?o.sub.map(x=>byId.get(x.id)).filter(isUnit):[];

// 물감: 지금은 파스텔 하나(다른 물감은 추후 출시). 예전 저장값(spring 등)은 모두 pastel 로 읽는다
const PAL={
  pastel:{n:'파스텔',c:['#f2a0a3','#f7c38d','#f1df84','#b6da96','#8fd2c6','#99c1ea','#c0afe8','#eeaad4']}
};
const lum=hex=>{const n=parseInt(hex.slice(1),16);return (0.299*((n>>16)&255)+0.587*((n>>8)&255)+0.114*(n&255))/255;};
const FILTERS=[
  {k:'none',n:'원본',css:'none'},
  {k:'blur',n:'블러',css:'blur(4px)'},
  {k:'vintage',n:'빈티지',css:'sepia(.45) contrast(1.08) saturate(.85) brightness(1.02)'},
  {k:'film',n:'필름',css:'contrast(1.15) saturate(1.2) hue-rotate(-6deg) brightness(1.03)'},
  {k:'bw',n:'흑백',css:'grayscale(1) contrast(1.1)'},
  {k:'warm',n:'따뜻하게',css:'sepia(.25) saturate(1.35) brightness(1.05)'},
  {k:'cool',n:'차갑게',css:'hue-rotate(12deg) saturate(.95) brightness(1.04) contrast(1.03)'},
  {k:'vivid',n:'선명하게',css:'saturate(1.45) contrast(1.12)'},
  {k:'dream',n:'몽환',css:'brightness(1.12) contrast(.88) saturate(1.2) sepia(.12)'},
  {k:'fade',n:'페이드',css:'contrast(.85) brightness(1.08) saturate(.8)'}
];
const filterCss=k=>(FILTERS.find(f=>f.k===k)||FILTERS[0]).css;

/* ---------- 저장소 ----------
 글 하나 = {id, r:지역id, d:'YYYY-MM-DD', b:[{t:'p',v:'문단'}|{t:'i',id:사진id,f:필터}], ts}
 (예전 형식 {t:'글', im:[...]}은 불러올 때 b로 바꾼다) */
const LS_KEY='muldeulida:v1', LS_OLD='muldeun-jido:v1';
let state={v:2,posts:[],settings:{palette:'pastel',hint:false,split:[],level:'si',islands:true}};
let lsOK=true, db=null;
const memPhotos=new Map(), urlCache=new Map();
function normPost(p){
  if(!p||typeof p!=='object')return null;
  let b=Array.isArray(p.b)?p.b.filter(x=>x&&(x.t==='p'&&typeof x.v==='string'||x.t==='i'&&x.id)).map(x=>x.t==='i'&&x.cr&&!['1:1','4:3','16:9'].includes(x.cr)?Object.assign({},x,{cr:undefined}):x):null;
  if(!b){b=[];if(p.t)b.push({t:'p',v:String(p.t)});for(const im of p.im||[])if(im&&im.id)b.push({t:'i',id:im.id,f:im.f||'none'});}
  const o={id:p.id,r:p.r,d:/^\d{4}-\d{2}-\d{2}$/.test(p.d)?p.d:todayStr(),b,ts:+p.ts||Date.now()};
  if(Array.isArray(p.x))o.x=p.x;if(/^\d{4}-\d{2}-\d{2}$/.test(p.d2)&&p.d2>o.d)o.d2=p.d2;if(typeof p.ti==='string'&&p.ti.trim())o.ti=p.ti.trim();if(['c','r'].includes(p.al))o.al=p.al;if(p.pv===true)o.pv=true;
  return o;
}
const postImgs=p=>p.b.filter(x=>x.t==='i');
const postText=p=>p.b.filter(x=>x.t==='p').map(x=>x.v).join('\n');
function loadState(){
  try{
    let raw=localStorage.getItem(LS_KEY);
    if(!raw&&localStorage.getItem(LS_OLD)){raw=localStorage.getItem(LS_OLD);state._migrate=true;}
    if(raw){const o=JSON.parse(raw);if(o&&Array.isArray(o.posts)){state.posts=o.posts.map(normPost).filter(p=>p&&p.id&&byId.has(p.r)&&!byId.get(p.r).nk);Object.assign(state.settings,o.settings||{});}}
    delete state.settings.wish;if(!Array.isArray(state.settings.split))state.settings.split=[];state.settings.split=state.settings.split.filter(id=>byId.has(id)&&Array.isArray(byId.get(id).sub));if(!['do','si','gu'].includes(state.settings.level))state.settings.level='si';if(typeof state.settings.islands!=='boolean')state.settings.islands=true;
    if(!PAL[state.settings.palette])state.settings.palette='pastel';
  }catch(e){lsOK=false;}
}
function saveState(){try{localStorage.setItem(LS_KEY,JSON.stringify({v:2,posts:state.posts,settings:state.settings}));}catch(e){lsOK=false;}}
function openIDB(name){
  return new Promise(res=>{
    try{const rq=indexedDB.open(name,1);rq.onupgradeneeded=()=>rq.result.createObjectStore('photos');rq.onsuccess=()=>res(rq.result);rq.onerror=()=>res(null);rq.onblocked=()=>res(null);}
    catch(e){res(null);}
  });
}
const idbReq=(d,mode,fn)=>new Promise(res=>{
  if(!d)return res(null);
  try{const tx=d.transaction('photos',mode);const rq=fn(tx.objectStore('photos'));tx.oncomplete=()=>res(rq&&rq.result!==undefined?rq.result:true);tx.onerror=()=>res(null);tx.onabort=()=>res(null);}
  catch(e){res(null);}
});
const putPhoto=(id,blob)=>{memPhotos.set(id,blob);return idbReq(db,'readwrite',s=>s.put(blob,id));};
const getPhoto=async id=>{if(memPhotos.has(id))return memPhotos.get(id);const b=await idbReq(db,'readonly',s=>s.get(id));if(b&&b!==true){memPhotos.set(id,b);return b;}return null;};
const delPhoto=id=>{memPhotos.delete(id);const u=urlCache.get(id);if(u){URL.revokeObjectURL(u);urlCache.delete(id);}return idbReq(db,'readwrite',s=>s.delete(id));};
async function photoURL(id){if(urlCache.has(id))return urlCache.get(id);const b=await getPhoto(id);if(!b)return null;const u=URL.createObjectURL(b);urlCache.set(id,u);return u;}
function setImg(img,id,f){photoURL(id).then(u=>{if(u){img.src=u;if(f)img.style.filter=filterCss(f);}else{img.alt='사진을 불러오지 못했어요';}});}
async function migrateOld(){
  const old=await openIDB('muldeun-jido');if(!old)return;
  for(const p of state.posts)for(const im of postImgs(p)){const b=await idbReq(old,'readonly',s=>s.get(im.id));if(b&&b!==true)await putPhoto(im.id,b);}
  old.close();saveState();try{localStorage.removeItem(LS_OLD);}catch(e){}
}

