const tagsOf=r=>{const t=new Set();for(const k in TAGSETS)if(TAGSETS[k].has(r.id))t.add(k);
  if(r.t==='i'){t.add('sea');t.add('quiet');t.add('heal');t.add('walk');t.add('rest');}
