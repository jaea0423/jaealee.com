function randomLand(){
  if(!landBox){
    landBox={sk:null,nk:null};
    for(const list of [SK,NKR]){let x0=1e9,y0=1e9,x1=-1e9,y1=-1e9;for(const r of list){const b=bboxOf(byId.get(r.id));x0=Math.min(x0,b.x);y0=Math.min(y0,b.y);x1=Math.max(x1,b.x+b.width);y1=Math.max(y1,b.y+b.height);}landBox[list===SK?'sk':'nk']=[x0,y0,x1,y1];}
  }
  const useNK=Math.random()<NK_CHANCE;
  const list=useNK?NKR:candidates();
  if(!list.length)return null;
  const ok=new Set(list.map(r=>r.id));
  const bb=landBox[useNK?'nk':'sk'];const pool=useNK?NKR:VIS();
  for(let i=0;i<600;i++){
    const x=bb[0]+Math.random()*(bb[2]-bb[0]),y=bb[1]+Math.random()*(bb[3]-bb[1]);
    for(const r of pool){const o=byId.get(r.id);if(inFill(o.el,x,y)){if(ok.has(r.id))return {r,x,y};break;}}
  }
  // 거의 다 물들어 땅을 못 찾으면 남은 곳 하나를 골라 그 안의 점을 쓴다
  const r=list[Math.floor(Math.random()*list.length)];const o=byId.get(r.id),b=o.el.getBBox();
