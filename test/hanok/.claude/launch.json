{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "hanok-v2",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "v2/work/serve.py",
        "8766"
      ],
      "port": 8766
    },
    {
      "name": "hanok-site",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8767",
        "--bind",
        "127.0.0.1"
      ],
      "port": 8767
    },
    {
      "name": "hanok",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8767",
        "--bind",
        "127.0.0.1",
        "--directory",
        "../../hanok"
      ],
      "port": 8767
    },
    {
      "name": "root",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8768",
        "--bind",
        "127.0.0.1",
        "--directory",
        "../.."
      ],
      "port": 8768
    }
  ]
}